# Database — use pooler URL for the app; direct URL for migrations only
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Local Docker Compose (optional — see ARCHITECTURE.md)
# DATABASE_URL="postgresql://farmstays:farmstays@localhost:5432/farmstays"
# DIRECT_URL="postgresql://farmstays:farmstays@localhost:5432/farmstays"

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Stripe (test mode for MVP)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Upstash Redis (caching + rate limiting — REST API, shared across instances)
UPSTASH_REDIS_REST_URL="https://..."
UPSTASH_REDIS_REST_TOKEN="..."

# BullMQ job queue (TCP Redis — local Docker or Upstash Redis protocol URL)
REDIS_URL="redis://localhost:6379"

# Cron / scheduled tasks (expire pending bookings)
# Vercel sends this automatically as Authorization: Bearer <CRON_SECRET> on cron hits.
# Hobby plans only run daily crons; Pro is required for the 15-minute schedule in vercel.json.
# Booking list/detail GET still expires stale pending requests without waiting for cron.
CRON_SECRET="generate-a-long-random-string"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_INVITE_CODE="GREENFIELD-ADMIN"
