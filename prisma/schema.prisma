generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id         String    @id @default(cuid())
  email      String?   @unique
  phone      String?   @unique
  fullName   String
  /// JSON string array of roles: guest | host | admin
  roles      String    @default("[\"guest\"]")
  language   String    @default("en")
  isVerified Boolean   @default(false)
  createdAt  DateTime  @default(now())
  listings   Listing[]
  bookingsMade Booking[] @relation("GuestBookings")
  guestEventRequests EventAvailabilityRequest[] @relation("GuestEventRequests")
  hostEventRequests  EventAvailabilityRequest[] @relation("HostEventRequests")
  reviews    Review[]
  hostProfile HostProfile?
  hostTrust   HostTrust?
  hostReviewsMeta HostReviewsMeta?
  hostStaff   HostStaff[]
  hostNotifications HostNotifications?
  hostAddons        HostAddons?
  hostAnalytics     HostAnalytics?
  hostAccounts      HostAccounts?
  hostBookingOps    HostBookingOps[]

  @@index([createdAt])
}

/// Full listing document stored as JSON so the existing UI shape is preserved.
/// Filter fields are also columns so public search can query without parsing payload.
/// country/state/district names stay denormalized; countryId/locationId are the future source of truth.
model Listing {
  id            String         @id
  propertyReference String     @unique
  hostId        String
  host          User           @relation(fields: [hostId], references: [id])
  title         String
  status        String         @default("pending")
  /// Full SubmittedListing JSON
  payload       String
  country       String         @default("")
  state         String         @default("")
  district      String         @default("")
  parentCategory String        @default("")
  category      String         @default("")
  subcategory   String         @default("")
  maxGuests     Int            @default(4)
  pricePerNight Float?
  /// Normalized geo — nullable until taxonomy import maps existing rows.
  countryId         String?
  countryRef        Country?   @relation("ListingCountry", fields: [countryId], references: [id], onDelete: Restrict)
  locationId        String?
  location          Location?  @relation("ListingLocation", fields: [locationId], references: [id], onDelete: Restrict)
  latitude          Decimal?   @db.Decimal(10, 7)
  longitude         Decimal?   @db.Decimal(10, 7)
  address           String?
  postalCode        String?
  timezone          String?
  showExactLocation Boolean    @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  bookings         Booking[]
  bookingNights    BookingNight[]
  eventAvailabilityRequests EventAvailabilityRequest[]
  experienceSlots  ExperienceSlot[]
  reviews          Review[]
  availability     Availability[]
  promotions       ListingPromotion[]
  /// Mirrors active featured promotion for fast search ranking
  featured      Boolean        @default(false)
  pricing       ListingPricing?
  availabilityMeta ListingAvailabilityMeta?

  @@index([hostId])
  @@index([status])
  @@index([featured])
  @@index([status, country])
  @@index([status, parentCategory])
  @@index([country, state, district])
  @@index([parentCategory, category, subcategory])
  @@index([countryId, status])
  @@index([locationId, status])
}

model Availability {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  date      DateTime
  isBlocked Boolean  @default(false)

  @@unique([listingId, date])
  @@index([listingId, date])
}

/// Host pricing rules — full ListingPricingSettings JSON
model ListingPricing {
  listingId String  @id
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  payload   String
  updatedAt DateTime @updatedAt
}

/// Host calendar rules (seasonal closures, min stay) + blockedDates in payload
model ListingAvailabilityMeta {
  listingId String  @id
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  payload   String
  updatedAt DateTime @updatedAt
}

model Booking {
  id            String    @id @default(cuid())
  bookingReference String  @unique
  listingId     String
  listing       Listing   @relation(fields: [listingId], references: [id])
  guestId       String
  guest         User      @relation("GuestBookings", fields: [guestId], references: [id])
  checkIn       DateTime
  checkOut      DateTime?
  guestCount    Int
  status        String    @default("pending")
  totalPrice    Float
  paymentStatus String    @default("unpaid")
  /// Request-to-book: host must respond before this time
  expiresAt     DateTime?
  /// flexible | moderate | strict | non-refundable
  policyId      String    @default("flexible")
  cancelledAt   DateTime?
  cancelReason  String?
  refundPercent Int?
  refundAmount  Float?
  stripeSessionId String?
  stripePaymentIntentId String?
  stripeRefundId  String?
  /// JSON GuestQuoteSnapshot — guest invoice line items
  guestQuoteSnapshot String?
  /// JSON FinancialSnapshot — internal ledger fields at payment
  financialSnapshot String?
  /// pending | checked_in | checked_out
  checkInStatus String    @default("pending")
  checkedInAt   DateTime?
  checkedOutAt  DateTime?
  /// manual | auto
  checkInSource  String?
  checkOutSource String?
  /// none | open | resolved
  disputeStatus      String    @default("none")
  disputeSummary     String?
  disputeGuestClaim  String?
  disputeHostResponse String?
  disputeResolution  String?
  disputeOpenedAt    DateTime?
  disputeResolvedAt  DateTime?
  noShow             Boolean   @default(false)
  /// JSON array of BookingAuditEntry
  auditLog           String    @default("[]")
  createdAt     DateTime  @default(now())
  messages      BookingMessage[]
  nights        BookingNight[]
  /// Set for experience (session) bookings; null for stay night bookings.
  experienceSlotId String?
  experienceSlot   ExperienceSlot? @relation(fields: [experienceSlotId], references: [id], onDelete: SetNull)

  @@index([listingId, checkIn, checkOut])
  @@index([status, expiresAt])
  @@index([guestId, status])
  @@index([listingId, status])
  @@index([experienceSlotId])
}

/// One row per occupied stay night — @@unique enforces no double-booking at the DB.
model BookingNight {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  date      DateTime

  @@unique([listingId, date])
  @@index([bookingId])
  @@index([listingId, date])
}

/// One capacity bucket per listing + date + session (Morning/Evening/…).
/// @@unique + row lock in confirmExperienceBooking prevent overselling spots.
model ExperienceSlot {
  id          String    @id @default(cuid())
  listingId   String
  listing     Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  /// Calendar day (UTC midnight)
  date        DateTime
  /// Stable key matching pricing session template (e.g. morning)
  sessionKey  String
  capacity    Int
  bookedCount Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bookings    Booking[]

  @@unique([listingId, date, sessionKey])
  @@index([listingId, date])
}

/// Singleton platform configuration (admin)
model PlatformSettings {
  id        String   @id @default("default")
  payload   String
  updatedAt DateTime @updatedAt
}

/// Host public profile — guest-facing host identity
model HostProfile {
  hostId    String   @id
  host      User     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  payload   String
  updatedAt DateTime @updatedAt
}

/// Directory listing (events/dining) availability enquiry — one row per request.
model EventAvailabilityRequest {
  id           String    @id
  listingId    String
  listing      Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingTitle String
  hostId       String
  host         User      @relation("HostEventRequests", fields: [hostId], references: [id], onDelete: Cascade)
  guestId      String
  guest        User      @relation("GuestEventRequests", fields: [guestId], references: [id], onDelete: Cascade)
  guestName    String
  guestEmail   String?
  guestPhone   String?
  spaceId      String?
  spaceName    String?
  occasion     String?
  partyType    String?
  /// YYYY-MM-DD when the guest picked a specific date.
  eventDate    String?
  dateFlexible Boolean   @default(false)
  guestCount   Int
  message      String?
  /// pending | available | unavailable
  status       String    @default("pending")
  createdAt    DateTime  @default(now())
  respondedAt  DateTime?
  hostNote     String?

  @@index([hostId, createdAt])
  @@index([guestId, createdAt])
  @@index([guestId, listingId])
  @@index([listingId, status])
}

model BookingMessage {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  /// guest | host | admin
  senderRole String
  senderId   String
  senderName String
  body       String
  createdAt  DateTime @default(now())

  @@index([bookingId, createdAt])
}

/// Paid Featured / Trending placements — same source search ranking reads
model ListingPromotion {
  id           String   @id
  listingId    String
  listing      Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  hostId       String
  kind         String
  durationDays Int
  priceAed     Float
  purchasedAt  DateTime
  startsAt     DateTime
  endsAt       DateTime
  status       String
  paymentRef   String
  createdAt    DateTime @default(now())

  @@index([listingId, kind, status])
  @@index([kind, status, endsAt])
}

/// Admin promote catalog (packages, pricing, copy)
model PromotionCatalogSettings {
  id        String   @id @default("default")
  payload   String
  updatedAt DateTime @updatedAt
}

/// Admin trust badge catalog + manual host flags
model TrustCatalogSettings {
  id        String   @id @default("default")
  payload   String
  updatedAt DateTime @updatedAt
}

/// Shared admin catalogs (taxonomy, photo-tags, extra-charges)
model PlatformCatalog {
  key       String   @id
  payload   String
  updatedAt DateTime @updatedAt
}

/// Host farm certifications + safety checklist
model HostTrust {
  hostId    String   @id
  host      User     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  payload   String
  updatedAt DateTime @updatedAt
}

/// Host review templates + per-review moderation/response overlays
model HostReviewsMeta {
  hostId    String   @id
  host      User     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  payload   String
  updatedAt DateTime @updatedAt
}

/// Host dashboard team members (manager/staff delegated access)
model HostStaff {
  id          String   @id @default(cuid())
  hostId      String
  host        User     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  name        String
  email       String
  /// owner | manager | staff
  role        String
  /// JSON array of HostStaffPermission strings
  permissions String
  active      Boolean  @default(true)
  /// scrypt hash (legacy plaintext upgraded on next login)
  password    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  assignedBookingOps HostBookingOps[]

  @@unique([hostId, email])
  @@index([email])
  @@index([hostId])
}

/// Host-only operational metadata for bookings and event enquiries (staff, notes, manual completion).
model HostBookingOps {
  id              String    @id @default(cuid())
  hostId          String
  host            User      @relation(fields: [hostId], references: [id], onDelete: Cascade)
  /// booking | event_request
  sourceType      String
  sourceId        String
  assignedStaffId String?
  assignedStaff   HostStaff? @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)
  privateNotes    String?
  /// Manual completion for event enquiries (bookings use Booking.status).
  completedAt     DateTime?
  updatedAt       DateTime  @updatedAt

  @@unique([sourceType, sourceId])
  @@index([hostId])
  @@index([hostId, assignedStaffId])
}

/// Host notification prefs + inbox alerts
model HostNotifications {
  hostId    String   @id
  host      User     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  payload   String
  updatedAt DateTime @updatedAt
}

/// Farm activities, products, and weather advisories for a host
model HostAddons {
  hostId    String   @id
  host      User     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  payload   String
  updatedAt DateTime @updatedAt
}

/// Host dashboard analytics snapshot (demo seed; future: derived from bookings)
model HostAnalytics {
  hostId    String   @id
  host      User     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  payload   String
  updatedAt DateTime @updatedAt
}

/// Host payout account (bank/UPI). Transactions are derived from Booking.
model HostAccounts {
  hostId    String   @id
  host      User     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  payload   String
  updatedAt DateTime @updatedAt
}

/// Platform admin console team (Super Admin / sub-admin / support)
model PlatformStaff {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  /// admin | sub_admin | support
  role        String
  /// JSON array of StaffPermission strings
  permissions String
  active      Boolean  @default(true)
  /// scrypt hash (legacy plaintext upgraded on next login)
  password    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([role])
}

model Review {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  /// One review per completed booking
  bookingId String?  @unique
  rating    Int
  comment   String
  /// pending | published | removed
  status    String   @default("published")
  createdAt DateTime @default(now())

  @@index([listingId, status])
}

/// Marketplace country — currency, tax, launch flags. Not a Location row.
model Country {
  id                        String     @id @default(cuid())
  name                      String
  officialName              String?
  iso2                      String     @unique
  iso3                      String?
  numericCode               String?
  phoneCode                 String?
  currencyCode              String     @default("AED") // keep in sync with src/lib/currency.ts BASE_CURRENCY
  currencySymbol            String?
  /// AED per 1 unit of this currency (existing marketplace rule)
  exchangeRateToAed         Float      @default(1)
  defaultLanguage           String     @default("en")
  timezone                  String?
  latitude                  Decimal?   @db.Decimal(10, 7)
  longitude                 Decimal?   @db.Decimal(10, 7)
  taxPct                    Float?
  taxLabel                  String?
  flag                      String?
  isActive                  Boolean    @default(true)
  isLaunchCountry           Boolean    @default(false)
  comingSoon                Boolean    @default(false)
  bookingEnabled            Boolean    @default(true)
  propertyPublishingEnabled Boolean    @default(true)
  /// Preserve taxonomy JSON id (c1, c2, …) for matching
  legacyTaxonomyId          String?    @unique
  createdAt                 DateTime   @default(now())
  updatedAt                 DateTime   @updatedAt
  locations                 Location[]
  listings                  Listing[]  @relation("ListingCountry")

  @@index([isActive, isLaunchCountry])
}

/// Hierarchical admin/geo node under a Country. Arbitrary depth via parentId.
model Location {
  id               String     @id @default(cuid())
  countryId        String
  country          Country    @relation(fields: [countryId], references: [id], onDelete: Restrict)
  parentId         String?
  parent           Location?  @relation("LocationTree", fields: [parentId], references: [id], onDelete: Restrict)
  children         Location[] @relation("LocationTree")
  name             String
  normalizedName   String
  slug             String
  /// string type: state | emirate | region | district | city | area | …
  type             String
  level            Int
  code             String?
  latitude         Decimal?   @db.Decimal(10, 7)
  longitude        Decimal?   @db.Decimal(10, 7)
  timezone         String?
  isActive         Boolean    @default(true)
  sortOrder        Int        @default(0)
  legacyTaxonomyId String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  aliases          LocationAlias[]
  translations     LocationTranslation[]
  listings         Listing[]  @relation("ListingLocation")

  @@index([countryId, parentId])
  @@index([countryId, type])
  @@index([countryId, slug])
  @@index([normalizedName])
  @@index([isActive])
  @@index([legacyTaxonomyId])
}

model LocationAlias {
  id              String   @id @default(cuid())
  locationId      String
  location        Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  alias           String
  normalizedAlias String
  languageCode    String   @default("en")
  createdAt       DateTime @default(now())

  @@index([normalizedAlias])
  @@index([locationId])
  @@unique([locationId, normalizedAlias, languageCode])
}

model LocationTranslation {
  id           String   @id @default(cuid())
  locationId   String
  location     Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  languageCode String
  name         String
  slug         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([locationId, languageCode])
}
